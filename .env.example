## Runtime only: Supabase Connect → Transaction pooler URL for serverless/Vercel.
DATABASE_URL=
# Prisma CLI/migrations only: Supabase Connect → Direct connection URL.
# Falls back to DATABASE_URL for local development when a direct URL is unavailable.
DIRECT_URL=
AUTH_SECRET=
CRON_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images


JASTIP_BANK_NAME=
JASTIP_BANK_ACCOUNT=
JASTIP_BANK_ACCOUNT_HOLDER=

MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_APP_URL=

# Optional payment reservation duration in minutes (minimum 5, default 30).
PAYMENT_EXPIRY_MINUTES=30
